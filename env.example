# GlottoLearn environment (copy to .env.local and fill in)
# Public browser config — safe to expose to clients (protected by Supabase RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enables real Paddle checkout (otherwise demo payments)
# Get the client token from Paddle → Setup → Client-side token
VITE_PADDLE_CLIENT_TOKEN=
# 'sandbox' for Paddle test mode, omit/other for live
VITE_PADDLE_ENV=

# --- Server-side (Supabase Edge Functions, NOT this app) ---
# Set with: supabase secrets set PADDLE_WEBHOOK_SECRET=...
# (from Paddle → Notifications → your webhook endpoint secret)
